{
  "contract_version": "tracecanary/v2",
  "semantic_conventions_version": "opentelemetry/semconv/1.43.0",
  "canaries": [
    {"label": "synthetic-db-statement", "category": "db_statement", "value": "TCANARY_DB_STATEMENT_7b3e2f81"},
    {"label": "synthetic-db-parameter", "category": "db_parameter", "value": "TCANARY_DB_PARAMETER_5d0a6c34"},
    {"label": "synthetic-db-row", "category": "db_result", "value": "TCANARY_DB_ROW_0f4c9b28"}
  ],
  "forbidden_attribute_keys": ["db.query.text", "db.statement"],
