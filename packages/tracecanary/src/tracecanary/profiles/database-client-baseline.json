      {
        "requirement_id": "query-summary-count",
        "scope": "span",
        "key": "db.query.summary",
        "value_types": ["stringValue"],
        "minimum_count": 1,
        "comparison": "count"
      }
    ]
  },
  "limits": {"max_input_bytes": 5000000, "max_nesting": 100, "max_batch_files": 256}
}
