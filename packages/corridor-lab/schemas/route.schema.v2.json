{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Corridor Lab fictional route v2",
  "description": "v2 adds declared tiered fee schedules and period charges. v1 documents are unaffected; use route.schema.json for corridor-lab.route/v1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "route_id", "label", "fictional", "fx_rate", "fx_spread_bps", "liquidity", "outcomes"],
  "properties": {
    "contract_version": {"const": "corridor-lab.route/v2"},
    "route_id": {"type": "string", "minLength": 1},
    "label": {"type": "string", "minLength": 1},
    "fictional": {"const": true},
    "fx_rate": {"$ref": "#/$defs/decimal"},
    "fixed_fee_send": {"$ref": "#/$defs/decimal"},
    "percent_fee_bps": {"$ref": "#/$defs/decimal"},
    "fx_spread_bps": {"$ref": "#/$defs/decimal"},
    "fee_schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "tiers"],
      "properties": {
        "basis": {"enum": ["marginal", "whole_band"]},
        "tiers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["upper_bound_send", "fixed_fee_send", "percent_fee_bps"],
            "properties": {
              "upper_bound_send": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/decimal"}]},
              "fixed_fee_send": {"$ref": "#/$defs/decimal"},
              "percent_fee_bps": {"$ref": "#/$defs/decimal"}
            }
          }
        },
        "period_charges": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "amount_send", "amortization_over"],
            "properties": {
              "label": {"type": "string", "minLength": 1, "maxLength": 64},
              "amount_send": {"$ref": "#/$defs/decimal"},
              "amortization_over": {"enum": ["declared_transactions", "scenario_volume"]},
              "period_transactions": {"$ref": "#/$defs/decimal"}
            }
          }
        }
      }
    },
    "liquidity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefunding_amount_send", "annual_cost_of_capital_bps", "holding_days"],
      "properties": {
        "prefunding_amount_send": {"$ref": "#/$defs/decimal"},
        "annual_cost_of_capital_bps": {"$ref": "#/$defs/decimal"},
        "holding_days": {"$ref": "#/$defs/decimal"}
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["outcome_id", "probability", "completion", "delay_hours", "recovery_amount_send", "recovery_delay_hours"],
        "properties": {
          "outcome_id": {"type": "string", "minLength": 1},
          "probability": {"$ref": "#/$defs/decimal"},
          "completion": {"enum": ["success", "failure"]},
          "delay_hours": {"$ref": "#/$defs/decimal"},
          "recovery_amount_send": {"$ref": "#/$defs/decimal"},
          "recovery_delay_hours": {"$ref": "#/$defs/decimal"}
        }
      }
    }
  },
  "oneOf": [
    {
      "description": "A flat declared fee. No tiered schedule may also be present.",
      "required": ["fixed_fee_send", "percent_fee_bps"],
      "not": {"required": ["fee_schedule"]}
    },
    {
      "description": "A declared tiered schedule. Flat fee fields must not also be present.",
      "required": ["fee_schedule"],
      "not": {
        "anyOf": [{"required": ["fixed_fee_send"]}, {"required": ["percent_fee_bps"]}]
      }
    }
  ],
  "$defs": {
    "decimal": {"type": ["string", "integer", "number"]}
  }
}
